{
  "name": "NetWave",
  "short_name": "NetWave",
  "start_url": "./index.html",
  "scope": "./",
  "scope_extensions": [
    {
      "origin": "https://robert9210.github.io",
      "relation": [
        "delegate_permission/common.handle_all_urls"
      ]
    }
  ],
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "background_color": "#0F0F12",
  "theme_color": "#0F0F12",
  "description": "Watch your favorite social media and videos in one place.",
  "id": "com.netwave.app",
  "orientation": "any",
  "categories": [
    "entertainment",
    "social",
    "utilities"
  ],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://robert9210.github.io/social-hub/manifest.json"
    }
  ],
  "iarc_rating_id": "e8488e1a-0e9a-48d6-94e8-8d4e96395786",
  "protocol_handlers": [
    {
      "protocol": "web+netwave",
      "url": "./index.html?value=%s"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "./index.html",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [
          ".txt"
        ]
      }
    }
  ],
  "widgets": [
    {
      "name": "NetWave Widget",
      "short_name": "Widget",
      "description": "Quick access widget for NetWave",
      "tag": "netwave-widget",
      "type": "application/json",
      "screenshots": [
        {
          "src": "icon-512.png",
          "sizes": "512x512"
        }
      ],
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ]
}
