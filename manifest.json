{
  "name": "NetWave",
  "short_name": "NetWave",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0F0F12",
  "theme_color": "#0F0F12",
